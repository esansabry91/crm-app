rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    // True only for a signed-in user whose /users/{uid} profile exists, has role "admin",
    // and has not been deactivated.
    function isAdmin() {
      return isSignedIn()
        && userDoc(request.auth.uid).data.role == 'admin'
        && userDoc(request.auth.uid).data.active != false;
    }

    // True only for a signed-in, active user with role "payroll" — a strictly view/export-only
    // Duty Roster role (see the /sites block below). Never grant this function's result write
    // access to anything; it exists so read rules can include payroll alongside admin/HQ
    // without also handing it the write access those roles get.
    function isPayroll() {
      return isSignedIn()
        && userDoc(request.auth.uid).data.role == 'payroll'
        && userDoc(request.auth.uid).data.active != false;
    }

    // True for any signed-in user whose profile exists and is still active (staff or admin).
    function isActiveUser() {
      return isSignedIn()
        && userDoc(request.auth.uid).data.active != false;
    }

    // True only for a signed-in, active user with role "branchManager" — used below to scope
    // the Quotation Calculator to admin + branchManager only (dutyStaff and payroll get none
    // of this collection).
    function isBranchManager() {
      return isSignedIn()
        && userDoc(request.auth.uid).data.role == 'branchManager'
        && userDoc(request.auth.uid).data.active != false;
    }

    // This user's own department (branch name, or "HQ").
    function myDepartment() {
      return userDoc(request.auth.uid).data.department;
    }

    // ---- Team member profiles ----
    // Staff can read only their own profile; admins can read/write everyone's.
    // Nobody but an admin can create or change a profile — this is what stops a staff
    // account from promoting itself to admin or reassigning its own department.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ---- Branches & brands (admin-editable lookup lists) ----
    match /branches/{branchId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }
    match /brands/{brandId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // ---- Tenders ----
    // Admins (HQ / Superior) see and manage every tender. Staff can only manage tenders where
    // they are the owner, and can never reassign a tender away from themselves nor create one
    // owned by someone else.
    //
    // Reading is a bit wider than managing, to support Active Projects: once a tender is Won,
    // anyone in the branch it's currently assigned to (`activeBranch`) can also read it — not
    // just its original owner — since Active Projects lists everyone's won work for that
    // branch, not just what any one person personally submitted. Anyone whose own department
    // is "HQ" can read every Won tender firm-wide (HQ holds no active projects of its own, but
    // oversees all of them). Non-Won tenders remain visible only to their owner and to admins.
    match /tenders/{tenderId} {
      allow read: if isActiveUser()
        && (
          isAdmin()
          || resource.data.ownerUid == request.auth.uid
          || (resource.data.stage == 'Won' && myDepartment() == 'HQ')
          || (resource.data.stage == 'Won' && resource.data.activeBranch == myDepartment())
          // A reassignment pending TO this user's branch (see Tender.pendingReassignment) — the
          // receiving Branch Manager needs to see it in Active Projects and decide on it even
          // though activeBranch hasn't moved to them yet.
          || (resource.data.stage == 'Won'
              && resource.data.get('pendingReassignment', null) != null
              && resource.data.pendingReassignment.toBranch == myDepartment())
        );

      allow create: if isActiveUser()
        && (isAdmin() || request.resource.data.ownerUid == request.auth.uid);

      // Once a tender's submittedDate is set, only an admin may write a DIFFERENT value into it —
      // a Branch Manager can key it in the first time (this stays true whether or not the field
      // existed before, since '!=' on a missing key compares against null), but if they need it
      // corrected afterwards they have to ask HQ. Used below in the owner's own update branch.
      function submittedDateUnchangedOrFirstSet() {
        return resource.data.get('submittedDate', null) == null
          || request.resource.data.submittedDate == resource.data.submittedDate;
      }

      // Non-owners can additionally update JUST the Active Project detail fields (location,
      // contact person, guards deployed, tender doc number, close-out status) on a Won tender
      // they can see in Active Projects — branch-mates in its activeBranch, or anyone in HQ —
      // mirroring the read rule above. affectedKeys().hasOnly([...]) is what keeps this narrow:
      // any write that also touches stage, value, ownerUid, department, etc. falls through and
      // is rejected unless the caller is the owner or an admin.
      allow update: if isActiveUser()
        && (
          isAdmin()
          || (resource.data.ownerUid == request.auth.uid
              && request.resource.data.ownerUid == request.auth.uid
              && submittedDateUnchangedOrFirstSet())
          || (
            resource.data.stage == 'Won'
            && (resource.data.activeBranch == myDepartment() || myDepartment() == 'HQ')
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['location', 'contactPerson', 'guardsDeployed', 'tenderDocNumber', 'closedOut', 'closedOutAt', 'updatedAt'])
          )
          // Accepting a pending reassignment (see Tender.pendingReassignment and
          // acceptReassignment() in services/tenders.ts) — only the Branch Manager (not
          // dutyStaff/payroll, even if their department happens to match) it's actually pending
          // TO, only flips activeBranch to the value that was actually offered, and only by
          // clearing pendingReassignment in the same write (never repurposing it).
          || (
            isBranchManager()
            && resource.data.stage == 'Won'
            && resource.data.get('pendingReassignment', null) != null
            && resource.data.pendingReassignment.toBranch == myDepartment()
            && request.resource.data.activeBranch == resource.data.pendingReassignment.toBranch
            && request.resource.data.get('pendingReassignment', null) == null
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['activeBranch', 'pendingReassignment', 'updatedAt'])
          )
        );

      // Staff can delete a tender they own (matches the create/update scoping above); admins
      // can delete any tender.
      allow delete: if isActiveUser() && (isAdmin() || resource.data.ownerUid == request.auth.uid);

      // ---- Change history (audit trail that powers the pipeline-value trend chart) ----
      // Denormalized `ownerUid` on each entry keeps this rule self-contained (no extra
      // get() on the parent tender), which is also what lets the collectionGroup query
      // in useTenderHistory.ts validate for staff (see the .where('ownerUid', ...) there).
      match /history/{historyId} {
        allow read: if isActiveUser() && (isAdmin() || resource.data.ownerUid == request.auth.uid);

        allow create: if isActiveUser()
          && (isAdmin() || request.resource.data.ownerUid == request.auth.uid);

        // Immutable audit log — nobody can ever edit a history entry once written. Deletion is
        // still admin-only (not staff, not even the entry's own owner), reserved for legitimate
        // data cleanup (e.g. scripts/purge-test-data.mjs) rather than routine use.
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ---- Duty Roster (public/duty-roster/index.html, embedded via an <iframe> on
    // /duty-roster) ----
    // A separate, self-contained tool with its own data model — client "sites", each with a
    // guard roster, shift/site config, and a per-month schedule. Each site is optionally
    // tagged with a `branch` (one of the names in /branches, matching a user's own
    // `department`) so a Branch Manager or "dutyStaff" account only reaches their own
    // branch's sites — mirroring the same branch-scoping tenders/Active Projects already use.
    // Admins, and anyone whose own department is "HQ" (oversight, same as elsewhere in this
    // app), can read/write every site regardless of its branch. A site with no `branch` set
    // at all (the field is optional — older/just-created sites may not have one yet) is left
    // open to every active user, rather than silently disappearing for everybody until an
    // admin tags it.
    //
    // A site may also carry an optional `tenderId`, linking it to the one Active Project it
    // belongs to — set once, automatically, the first time someone opens that project's Duty
    // Roster link (see index.html's ?tenderId= deep-link handling and createSite()). This is
    // purely a data-model link, not a permission boundary for reaching a site NORMALLY —
    // branch-scoping above still does that job, exactly as it did before this field existed. The
    // one exception is acceptReassignment() in services/tenders.ts: while a tender's
    // pendingReassignment names this user's branch as the target, they need to touch the OLD
    // site tied to it (still branch-scoped to the FROM branch, so canReachSite() alone would
    // reject them) to either move it over or archive-and-unlink it — see
    // isAcceptingPendingReassignment() below, the one place this file does a get() on /tenders.
    // `archived`/`archivedAt` follow the same story otherwise — set by setLinkedSitesArchived()
    // in the CRM's src/services/tenders.ts when that tender is closed out (or cleared when it's
    // reopened) — and are ordinary fields under the same read/write rules as everything else on
    // the doc; index.html decides client-side whether an archived site still belongs in a given
    // user's picker.
    match /sites/{siteId} {
      function siteBranch(data) {
        return data.get('branch', null);
      }
      function canReachSite(data) {
        return isAdmin()
          || myDepartment() == 'HQ'
          || siteBranch(data) == null
          || siteBranch(data) == myDepartment();
      }
      // Payroll reads every site regardless of branch (same reach as admin/HQ) but must never
      // write — kept as a separate function from canReachSite so it's easy to see that the
      // create/update/delete rules below deliberately do NOT call this one.
      function canReadSite(data) {
        return canReachSite(data) || isPayroll();
      }
      // True only for a Branch Manager accepting a reassignment actually pending to their own
      // branch (see Tender.pendingReassignment / acceptReassignment()) for THIS site's tender —
      // narrow on purpose: it only ever lets them touch the site's branch/tenderId/archived
      // fields (enforced below, not here), never anything else about it.
      function isAcceptingPendingReassignment(oldData) {
        return isBranchManager()
          && oldData.get('tenderId', null) != null
          && get(/databases/$(database)/documents/tenders/$(oldData.tenderId)).data.get('pendingReassignment', null) != null
          && get(/databases/$(database)/documents/tenders/$(oldData.tenderId)).data.pendingReassignment.toBranch == myDepartment();
      }

      // The second clause matters: acceptReassignment() in services/tenders.ts queries sites by
      // tenderId BEFORE it can update one, and a query silently drops documents the caller can't
      // read rather than erroring — so without this, the receiving Branch Manager's query would
      // just come back empty and their write would never even attempt to run.
      allow read: if isActiveUser() && (canReadSite(resource.data) || isAcceptingPendingReassignment(resource.data));
      allow create: if isActiveUser() && !isPayroll() && canReachSite(request.resource.data);
      // Both old and new data must be in reach — the first clause keeps a non-privileged
      // user from touching a site outside their branch at all, the second keeps them from
      // reassigning a reachable site's branch to one they don't belong to. !isPayroll() blocks
      // the Payroll role from writing at all, even to a site it can read. The second OR branch
      // is the one narrow exception: a Branch Manager accepting a pending reassignment (see
      // isAcceptingPendingReassignment() above) touching the OLD, not-yet-theirs site — limited
      // to exactly the fields acceptReassignment() actually writes.
      allow update: if isActiveUser() && !isPayroll() && (
        (canReachSite(resource.data) && canReachSite(request.resource.data))
        || (
          isAcceptingPendingReassignment(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['branch', 'tenderId', 'archived', 'archivedAt', 'updatedAt'])
        )
      );
      allow delete: if isActiveUser() && !isPayroll() && canReachSite(resource.data);

      match /months/{monthKey} {
        allow read: if isActiveUser()
          && canReadSite(get(/databases/$(database)/documents/sites/$(siteId)).data);
        allow write: if isActiveUser() && !isPayroll()
          && canReachSite(get(/databases/$(database)/documents/sites/$(siteId)).data);
      }
    }

    // ---- Quotation Calculator (public/quotation-calculator/index.html, embedded via an
    // <iframe> on /quotation-calculator) ----
    // Only admin and branchManager ever reach this tool at all (gated in the CRM's own
    // routing/nav, and independently re-checked here — dutyStaff and payroll get isActiveUser()
    // but neither isAdmin() nor isBranchManager(), so canReachQuote() is false for them no
    // matter what). Every saved quotation is tagged with the branch it belongs to (the saving
    // Branch Manager's own department, always — never a value they choose) plus who created it
    // (createdByUid/createdByName), mirroring the same branch-scoping /sites already uses.
    // Unlike /sites, a quotation with no branch set is NOT open to everyone — pricing data is
    // sensitive, so an unassigned quotation is admin/HQ-only until it's tagged to a branch.
    match /quotations/{quoteId} {
      function quoteBranch(data) {
        return data.get('branch', null);
      }
      function canReachQuote(data) {
        return isAdmin()
          || myDepartment() == 'HQ'
          || (isBranchManager() && quoteBranch(data) == myDepartment());
      }

      allow read: if isActiveUser() && canReachQuote(resource.data);
      // createdByUid must match the signed-in caller — mirrors tenders' ownerUid check — so a
      // save can never be filed under someone else's name.
      allow create: if isActiveUser()
        && (isAdmin() || isBranchManager())
        && request.resource.data.createdByUid == request.auth.uid
        && canReachQuote(request.resource.data);
      // Both old and new data must be in reach, same reasoning as /sites' update rule: keeps a
      // Branch Manager from touching a quotation outside their branch, and from moving a
      // reachable one to a branch they don't belong to.
      allow update: if isActiveUser() && canReachQuote(resource.data) && canReachQuote(request.resource.data);
      allow delete: if isActiveUser() && canReachQuote(resource.data);
    }
  }
}
